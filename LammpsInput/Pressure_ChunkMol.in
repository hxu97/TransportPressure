# Advanced method, under test stage
# Before running, please appropriatly set all parameters in [square brackets]

# Variable setting 
# Simulation box dimension
variable length_x_box equal [length_x_box] # A 
variable length_y_box equal [length_y_box] # A
variable length_z_box equal [length_z_box] # A
variable T equal 300 # K 
# Generally, the water transport from the bottom to top
variable pressure_down equal [pressure_down] # Pa, Feed pressure, positive
variable pressure_up equal [pressure_up] # Pa, Permeate pressure, negative
# nbins = length_z / bin_interval
variable nbins equal floor(v_length_z_box/5.0) # 1 
variable fraction equal 1.0/v_nbins # 1 
variable number_piston equal [number_piston] # 1, atom number of each piston 
variable Nevery_avetime equal 100 # 1, Nevery for fix ave/time command
variable Nrepeat_avetime equal 1000 # 1, Nrepeat for fix ave/time command 
variable Nfreq_avetime equal 1000000 # 1, Nfreq for fix ave/time command 
variable Nevery_avechunk equal 100 # 1, Nevery for fix ave/chunk command  
variable Nrepeat_avechunk equal 1000 # 1, Nrepeat for fix ave/chunk command
variable Nfreq_avechunk equal 1000000 # 1, Nfreq for fix ave/chunk command  
    # Unit convert 
variable A2m equal 1e-10 
variable kcal2J equal 4184 
variable mol2unit equal 6.02e23 

# Environment setting
dimension 3
boundary p p f 
units real 
atom_style full 
pair_style lj/cut/coul/long 10.0
neighbor 2.0 bin 
neigh_modify delay 0 every 1 check yes
#neigh_modify one 10000
kspace_style pppm 1.0e-4 
kspace_modify slab 3.0 
# CVFF
pair_modify mix arithmetic 
bond_style harmonic 
angle_style harmonic 
dihedral_style harmonic # fourier 
improper_style cvff 
# GAFF
#pair_modify mix arithmetic 
#bond_style harmonic 
#angle_style harmonic 
#dihedral_style fourier 
#improper_style cvff 
# OPLS-AA
#pair_modify mix geometric 
#bond_style harmonic 
#angle_style harmonic 
#dihedral_style nharmonic   
#improper_style cvff 
timestep 1.5 

# Variable setting

# Read initial configuration 
read_data [lammps_configuration].data 
set type [water_hydrogen_type] charge 0.417 
set type [water_oxygen_type] charge -0.834
pair_coeff 10 11 0.0 1.0

# Group setting 
group pistondown id [atom_id_of_bottom_piston] 
group pistonup id [atom_id_of_bottom_piston]
group fixed_membrane id [atom_id_of_frozen_atoms_in_membrane]
group water type [water_hydrogen_type] [water_oxygen_type]
group water_oxygen type [water_oxygen_type] 
group pistons union pistondown pistonup 
group membrane subtract all pistons water 
group flexible_membrane subtract membrane fixed_membrane 
group NVTgroup union water membrane 
group stressable_atoms union water flexible_membrane 

# Output setting 
thermo 10000
thermo_style custom step vol temp density enthalpy press pe ke etotal evdwl ecoul ebond eangle edihed eimp 
shell mkdir Press 
shell mkdir Density 

# Global fix setting 
velocity fixed_membrane set 0.0 0.0 0.0 units box
velocity pistons set 0.0 0.0 0.0 units box
fix fixG1 all wall/reflect zlo EDGE zhi EDGE 
fix fixG2 fixed_membrane setforce 0.0 0.0 0.0
fix fixG3 pistons setforce 0.0 0.0 NULL 
variable force_down equal ${pressure_down}*${length_x_box}*${length_y_box}/${number_piston}*(${A2m}*${A2m}/${kcal2J}*${mol2unit}*${A2m}) 
variable force_up equal ${pressure_up}*${length_x_box}*${length_y_box}/${number_piston}*(${A2m}*${A2m}/${kcal2J}*${mol2unit}*${A2m}) 
fix fixG4 pistondown aveforce NULL NULL ${force_down} 
fix fixG5 pistonup aveforce NULL NULL ${force_up} 

# Run0:
minimize 1.0e-4 1.0e-6 1000 100000 
#reset_timestep 0 
write_data afterMinimize.data
fix fixG6 water shake 0.001 100 1000 b [bond_type_of_O-H_in_water] a [angle_type_of_H-O-H_in_water]

# Run1 
fix fix11 NVTgroup nvt temp $T $T 100.0 
fix fix12 pistons nve 
run 100000000 
write_data finalPush.data 
unfix fix12 
unfix fix11

